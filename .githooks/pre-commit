#!/usr/bin/env bash
# Gates as physics: the six-gate suite runs before every commit.
# Escape hatch for genuine emergencies only: KICLI_SKIP_HOOK=1 git commit …
# — a skipped run is reported in the session report, not hidden.
set -euo pipefail
if [ "${KICLI_SKIP_HOOK:-0}" = "1" ]; then
  echo "pre-commit: gates SKIPPED via KICLI_SKIP_HOOK — report this." >&2
  exit 0
fi
# A git hook does not read the interactive shell's profile, so cargo is found
# here only if it is already on PATH. Resolve it the way rustup installs it
# before giving up, or the gates silently become "no commit" instead of "no
# unchecked commit".
if command -v cargo >/dev/null 2>&1; then
  cargo=cargo
elif [ -x "${CARGO_HOME:-$HOME/.cargo}/bin/cargo" ]; then
  cargo="${CARGO_HOME:-$HOME/.cargo}/bin/cargo"
else
  # The remedy is naming the missing tool, never the escape hatch. An error
  # that mentions KICLI_SKIP_HOOK turns a missing binary into a skipped gate
  # suite, which is the opposite of what this hook is for.
  echo "pre-commit: cargo not found on PATH or under ${CARGO_HOME:-$HOME/.cargo}/bin." >&2
  echo "pre-commit: the gates cannot run, so the commit is refused." >&2
  echo "pre-commit: put cargo on PATH, or install rustup from https://rustup.rs." >&2
  echo "pre-commit: then commit again." >&2
  exit 1
fi
exec "$cargo" xtask check
